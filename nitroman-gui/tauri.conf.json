{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NitroMan",
  "version": "1.0.0",
  "identifier": "com.nitroman.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NitroMan - Acer Nitro Control Center",
        "width": 1200,
        "height": 800,
        "minWidth": 950,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "devtools": true,
        "theme": "Dark"
      },
      {
        "label": "hud",
        "title": "NitroMan HUD",
        "url": "hud.html",
        "width": 560,
        "height": 320,
        "minWidth": 320,
        "minHeight": 140,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
